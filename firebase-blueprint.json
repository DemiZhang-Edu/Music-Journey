{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "MusicPiece": {
      "title": "Music Piece",
      "description": "Information about a flute music piece",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "composer": { "type": "string" },
        "era": { "type": "string" },
        "style": { "type": "string" },
        "background": { "type": "string" },
        "pdfAnalysis": {
          "type": "object",
          "properties": {
            "tempo": { "type": "string" },
            "keyPoints": { "type": "string" },
            "practiceSuggestions": { "type": "string" }
          }
        },
        "difficultyAnalysis": {
          "type": "object",
          "properties": {
            "overall": { "type": "string" },
            "keySections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "measureRange": { "type": "string" },
                  "description": { "type": "string" },
                  "tips": { "type": "string" }
                }
              }
            }
          }
        },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "userId"]
    },
    "PracticeLog": {
      "title": "Practice Log",
      "description": "A record of a single practice session",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "pieceId": { "type": "string" },
        "pieceTitle": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "duration": { "type": "number", "description": "Duration in minutes" },
        "practiceType": { "type": "string", "enum": ["self", "with_teacher"] },
        "listenedToPerformances": { "type": "string" },
        "targetTempo": { "type": "string" },
        "notes": { "type": "string" },
        "encouragement": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "duration", "practiceType"]
    },
    "Competition": {
      "title": "Competition Plan",
      "description": "A researched competition plan with dates and requirements",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "eventName": { "type": "string" },
        "date": { "type": "string", "description": "Format: YYYY-MM-DD" },
        "requirements": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "eventName", "date", "requirements"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "User collection"
    },
    "pieces": {
      "schema": "MusicPiece",
      "description": "Music pieces added by users"
    },
    "practices": {
      "schema": "PracticeLog",
      "description": "Practice logs recorded by users"
    },
    "competitions": {
      "schema": "Competition",
      "description": "Competition plans researched by AI"
    }
  }
}
