{
  "entities": {
    "Piece": {
      "title": "Music Piece",
      "description": "A musical piece in the user's library",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "composer": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "background": { "type": "string" },
        "era": { "type": "string" },
        "style": { "type": "string" },
        "difficultyAnalysis": { "type": "object" },
        "pdfAnalysis": { "type": "object" }
      },
      "required": ["id", "title", "userId", "createdAt"]
    },
    "PracticeEntry": {
      "title": "Practice Log Entry",
      "description": "A record of a single practice session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "pieceId": { "type": "string" },
        "pieceTitle": { "type": "string" },
        "duration": { "type": "number" },
        "notes": { "type": "string" },
        "practiceType": { "type": "string", "enum": ["self", "with_teacher"] },
        "targetTempo": { "type": "string" },
        "listenedToPerformances": { "type": "string" },
        "encouragement": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "pieceId", "duration", "date", "createdAt"]
    },
    "Competition": {
      "title": "Competition Event",
      "description": "A musical competition or performance event",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "location": { "type": "string" },
        "url": { "type": "string" },
        "info": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "date", "createdAt"]
    },
    "WeeklyReport": {
      "title": "Weekly AI Report",
      "description": "A summary report generated by AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "content", "date", "createdAt"]
    }
  },
  "firestore": {
    "pieces": {
      "schema": "Piece",
      "description": "User's music library"
    },
    "logs": {
      "schema": "PracticeEntry",
      "description": "Practice history"
    },
    "competitions": {
      "schema": "Competition",
      "description": "Planned events"
    },
    "reports": {
      "schema": "WeeklyReport",
      "description": "AI generated reports"
    }
  }
}
