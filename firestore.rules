rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Piece Validation
    function isValidPiece(data) {
      return data.keys().hasAll(['id', 'title', 'userId', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.userId == request.auth.uid
        && data.createdAt is string // Schema says string format date-time
        && (!('composer' in data) || (data.composer is string && data.composer.size() <= 200))
        && (!('background' in data) || (data.background is string && data.background.size() <= 5000));
    }

    match /pieces/{pieceId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidPiece(request.resource.data) && isValidId(pieceId);
      allow update: if isOwner(resource.data.userId) 
        && isValidPiece(request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(resource.data.userId);
    }

    // Logs Validation
    function isValidLog(data) {
      return data.keys().hasAll(['id', 'userId', 'pieceId', 'pieceTitle', 'duration', 'date', 'createdAt'])
        && data.id is string
        && data.userId == request.auth.uid
        && data.duration is number && data.duration >= 0
        && data.pieceId is string;
    }

    match /logs/{logId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidLog(request.resource.data) && isValidId(logId);
      allow update: if isOwner(resource.data.userId) && isValidLog(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }

    // Competitions Validation
    function isValidCompetition(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'date', 'createdAt'])
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 200;
    }

    match /competitions/{eventId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidCompetition(request.resource.data) && isValidId(eventId);
      allow update: if isOwner(resource.data.userId) && isValidCompetition(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }

    // Reports Validation
    function isValidReport(data) {
      return data.keys().hasAll(['id', 'userId', 'content', 'date', 'createdAt'])
        && data.userId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidReport(request.resource.data) && isValidId(reportId);
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
